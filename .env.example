# Copy to .env for local development. Never commit .env.

# "development" or "production". Production refuses to start with the default JWT secret.
APP_ENV=development

# SQLite for local dev/tests; Postgres in production (postgres:// URLs are normalized automatically).
DATABASE_URL=sqlite:///./local.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PDF extraction (Claude API). Required for the upload endpoint.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

MAX_UPLOAD_MB=20
